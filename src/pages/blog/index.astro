---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABanner from "../../components/CTABanner.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const dateFmt = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout
  title="Blog — SEO, GEO et création de site pour petites entreprises"
  description="Des articles concrets sur le référencement, le GEO, le prix d'un site internet et la stratégie digitale des petites entreprises."
>
  <section class="container-balise pt-16 pb-12">
    <p class="text-sm font-medium uppercase tracking-wide text-moss">Blog</p>
    <h1 class="mt-3 max-w-2xl font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      Comprendre le web, sans jargon
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft">
      SEO, GEO, prix, structure de site : des articles écrits pour des dirigeants de petites entreprises qui n'ont pas de temps à perdre en abstractions.
    </p>
  </section>

  <section class="container-balise py-8 pb-24">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`${base}/blog/${post.id}`} class="group flex flex-col rounded-2xl border border-line bg-white p-6 transition-colors hover:border-moss">
          <span class="text-xs text-stone">{dateFmt.format(post.data.pubDate)}</span>
          <h2 class="mt-3 font-display text-lg font-semibold text-ink group-hover:text-moss">{post.data.title}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{post.data.description}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-moss">
            Lire l'article →
          </span>
        </a>
      ))}
    </div>
  </section>

  <CTABanner
    title="Envie d'un blog comme celui-ci pour votre activité ?"
    description="L'option Blog + 10 articles s'ajoute au pack Site Vitrine pour 200€ seulement."
    cta="Voir l'option blog"
    href={`${base}/tarifs`}
  />
</BaseLayout>
