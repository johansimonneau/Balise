---
import NicheLanding from "../../components/NicheLanding.astro";
---

<NicheLanding
  metier="commerce local"
  path="/sites-internet/commerce-local"
  metaTitle="Site internet pour commerce local — 400€, 20-30 pages"
  metaDescription="Balise crée le site internet de votre commerce de proximité : boutique, épicerie, salon, magasin spécialisé. Présentez vos produits et votre boutique, dès 400€."
  heroKicker="Pour les commerces locaux"
  heroTitle="Existez aussi en dehors des heures d'ouverture"
  heroText="Un commerce de quartier ferme le soir, mais les recherches Google continuent. Un site qui présente vos produits, votre univers et vos horaires capte ces recherches et donne une bonne raison de pousser la porte le lendemain."
  painPoints={[
    { title: "\"Je vends surtout en magasin, à quoi bon un site ?\"", text: "Le site ne remplace pas votre boutique : il sert de vitrine qui donne envie de venir, visible même quand le magasin est fermé." },
    { title: "\"Je n'ai pas de catalogue en ligne à jour\"", text: "Pas besoin d'un site e-commerce complexe : présenter vos univers de produits et vos spécialités suffit à donner envie de passer en boutique." },
    { title: "\"Je veux me démarquer des grandes enseignes\"", text: "Une page 'notre histoire' et une mise en avant de votre sélection ou de votre savoir-faire créent une différenciation qu'une grande enseigne ne peut pas reproduire." },
  ]}
  pagesNote="Un exemple pour un commerce de proximité type boutique ou magasin spécialisé, adaptable selon vos univers de produits."
  pages={[
    "Accueil",
    "Nos univers / catégories de produits",
    "Notre sélection ou nos coups de cœur",
    "Notre histoire",
    "Horaires et accès",
    "Événements en boutique",
    "Newsletter ou actualités",
    "Contact",
  ]}
  faq={[
    { question: "Puis-je vendre en ligne directement depuis ce site ?", answer: "Le pack de base ne inclut pas de paiement en ligne intégré : il est pensé pour présenter votre boutique et donner envie de vous rendre visite. Une boutique en ligne complète peut être étudiée séparément sur devis." },
    { question: "Puis-je mettre en avant des arrivages ou promotions ponctuelles ?", answer: "Oui, une section dédiée peut être prévue pour vos actualités commerciales, à mettre à jour vous-même simplement." },
    { question: "Est-ce utile si je vends surtout via les réseaux sociaux ?", answer: "Un site complète vos réseaux sociaux : il capte les recherches Google que les réseaux sociaux ne couvrent pas, et donne une image plus établie de votre commerce." },
  ]}
  testimonial={{
    quote: "Les gens tapaient le nom de ma boutique sur Google et tombaient sur rien de sérieux. Maintenant ils voient nos produits avant même de venir.",
    name: "Sophie L.",
    role: "Gérante d'une boutique de décoration",
  }}
/>
