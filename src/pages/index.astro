---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import TestimonialCard from "../components/TestimonialCard.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Balise",
  url: `${siteOrigin}${base}/`,
  logo: `${siteOrigin}${base}/favicon.svg`,
  description:
    "Balise conçoit des sites internet vitrines pour les petites entreprises grâce à l'intelligence artificielle, à partir de 400€.",
  areaServed: "FR",
  founder: {
    "@type": "Person",
    name: "Johan Simonneau",
  },
};

const steps = [
  {
    n: "01",
    title: "On cadre votre activité",
    text: "Un court échange (formulaire ou appel de 15 min) pour comprendre votre métier, vos services et ce que vos clients cherchent vraiment.",
  },
  {
    n: "02",
    title: "L'IA structure et rédige",
    text: "Arborescence, textes, structure SEO : l'IA génère un premier site complet en s'appuyant sur vos informations, sous supervision humaine.",
  },
  {
    n: "03",
    title: "On relit, on ajuste",
    text: "Chaque page est relue, corrigée et mise en cohérence avec votre marque avant mise en ligne. Rien ne part sans validation humaine.",
  },
  {
    n: "04",
    title: "Mise en ligne et suivi",
    text: "Votre site est publié, indexé, et vous recevez un mode d'emploi simple pour le faire vivre au quotidien.",
  },
];
---

<BaseLayout
  title="Balise — Sites internet créés par l'IA pour petites entreprises, dès 400€"
  description="Balise crée votre site vitrine avec l'IA : 20 à 30 pages, rédaction SEO incluse, mise en ligne rapide. Dès 400€ net, sans abonnement caché."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="reveal container-balise pt-16 pb-20 sm:pt-24 sm:pb-28">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-1.5 text-xs font-medium text-ink-soft">
          <span class="h-1.5 w-1.5 rounded-full bg-signal"></span>
          Sites vitrines par IA + relecture humaine, dès 400€
        </p>
        <h1 class="mt-6 font-display text-3xl font-bold leading-[1.15] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          Chaque jour sans site, c'est un client qui part <span class="text-signal">voir ailleurs</span>.
        </h1>
        <p class="mt-4 max-w-xl text-xl font-semibold text-ink">
          Le vôtre peut être en ligne dans 10 jours.
        </p>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink-soft">
          Balise conçoit des sites vitrines de 20 à 30 pages pour les artisans, indépendants et petits commerces qui n'ont ni le temps ni l'envie de se battre avec un éditeur de site.
          Contenu rédigé, structure pensée pour le référencement. À partir de <strong class="text-ink">400€ net</strong>, sans abonnement obligatoire.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={`${base}/tarifs`} class="inline-flex items-center justify-center rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-paper transition-transform hover:-translate-y-0.5 hover:bg-signal">
            Voir la grille tarifaire
          </a>
          <a href={`${base}/realisations`} class="inline-flex items-center justify-center rounded-full border border-line bg-white px-6 py-3.5 text-sm font-semibold text-ink transition-colors hover:border-ink">
            Voir des exemples
          </a>
        </div>
        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-soft">
          <span>✓ Contenu rédigé pour vous, pas un générateur générique</span>
          <span>✓ Prix fixe communiqué à l'avance</span>
          <span>✓ Hébergement inclus, nom de domaine accompagné (achat à votre charge)</span>
        </div>
      </div>

      <div class="relative">
        <div class="grain rounded-3xl border border-line bg-white p-6 shadow-2xl shadow-ink/5">
          <div class="flex items-center gap-1.5 border-b border-line pb-4">
            <span class="h-2.5 w-2.5 rounded-full bg-clay/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-stone/50"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-signal/60"></span>
            <span class="ml-3 text-xs text-stone">votre-entreprise.fr</span>
          </div>
          <div class="mt-5 space-y-4">
            <div class="h-6 w-2/3 rounded bg-paper-dim"></div>
            <div class="h-32 rounded-xl bg-signal-light"></div>
            <div class="grid grid-cols-3 gap-3">
              <div class="h-16 rounded-lg bg-paper-dim"></div>
              <div class="h-16 rounded-lg bg-paper-dim"></div>
              <div class="h-16 rounded-lg bg-paper-dim"></div>
            </div>
            <div class="h-4 w-full rounded bg-paper-dim"></div>
            <div class="h-4 w-5/6 rounded bg-paper-dim"></div>
          </div>
        </div>
        <div class="absolute -bottom-6 -left-6 hidden rounded-2xl border border-line bg-ink px-5 py-4 text-paper shadow-xl sm:block">
          <p class="font-display text-2xl font-bold">20-30</p>
          <p class="text-xs text-paper/70">pages livrées, dès 400€</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pour qui -->
  <section class="reveal border-y border-line bg-paper-dim py-16">
    <div class="container-balise">
      <p class="text-center text-sm font-medium uppercase tracking-wide text-stone">Pensé pour ceux qui n'ont pas le temps</p>
      <div class="mt-8 grid grid-cols-2 gap-4 text-center sm:grid-cols-3 lg:grid-cols-6">
        {[
          { href: `${base}/sites-internet/artisan`, label: "Artisans" },
          { href: `${base}/sites-internet/profession-liberale`, label: "Professions libérales" },
          { href: `${base}/sites-internet/restaurant`, label: "Restaurants" },
          { href: `${base}/sites-internet/commerce-local`, label: "Commerces locaux" },
          { href: `${base}/sites-internet/coach-independant`, label: "Coachs & indépendants" },
          { href: `${base}/sites-internet/association`, label: "Associations" },
        ].map((item) => (
          <a href={item.href} class="rounded-xl border border-line bg-white px-4 py-4 text-sm font-medium text-ink-soft transition-colors hover:border-signal hover:text-signal">
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="reveal container-balise py-24">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink">De l'idée au site en ligne, en 4 étapes</h2>
      <p class="mt-4 text-ink-soft">Aucune étape magique cachée : voici exactement ce qui se passe entre votre premier message et la mise en ligne.</p>
    </div>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <div class="rounded-2xl border border-line bg-white p-6">
          <span class="font-display text-3xl font-bold text-signal/30">{step.n}</span>
          <h3 class="mt-4 font-display text-lg font-semibold text-ink">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{step.text}</p>
        </div>
      ))}
    </div>
    <a href={`${base}/comment-ca-marche`} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-signal hover:underline">
      Voir le détail du processus →
    </a>
  </section>

  <!-- Preuve sociale -->
  <section class="reveal container-balise py-8 pb-24">
    <h2 class="font-display text-3xl font-bold tracking-tight text-ink">Ce qu'on nous dit</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <TestimonialCard
        quote="Je repoussais mon site depuis deux ans. Là, en une semaine j'avais quelque chose de propre, avec des vraies pages sur mes prestations."
        name="Sarah M."
        role="Coach en reconversion professionnelle"
      />
      <TestimonialCard
        quote="Le prix annoncé au départ, c'est le prix payé à la fin. Pas de surprise, pas de ligne cachée."
        name="Karim B."
        role="Artisan plombier-chauffagiste"
      />
      <TestimonialCard
        quote="J'ai pris l'option blog avec les 10 articles. Deux mois après, je remonte déjà sur des recherches locales."
        name="Élodie R."
        role="Créatrice d'un commerce local"
      />
    </div>
    <p class="mt-4 text-xs text-stone">Témoignages illustratifs représentatifs des retours reçus en phase de lancement — les avis clients vérifiés seront publiés au fil des projets livrés.</p>
  </section>

  <CTABanner />
</BaseLayout>
