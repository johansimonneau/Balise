---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";

const steps = [
  {
    n: "1",
    title: "Vous décrivez votre activité",
    duration: "Jour 1",
    text: "Un formulaire simple (ou un appel de 15 minutes si vous préférez) : votre métier, vos services, votre zone d'intervention, ce qui vous différencie. Pas besoin d'avoir déjà des textes prêts — c'est notre travail de les écrire.",
  },
  {
    n: "2",
    title: "L'architecture du site est posée",
    duration: "Jour 2-3",
    text: "À partir de vos réponses, l'arborescence des 20 à 30 pages est construite : quelles pages, dans quel ordre, pour répondre aux questions que se posent vos clients avant de vous contacter.",
  },
  {
    n: "3",
    title: "L'IA rédige, page par page",
    duration: "Jour 3-6",
    text: "Chaque page est rédigée à partir de vos informations réelles, avec une structure pensée pour le référencement (titres, mots-clés, longueur adaptée). Aucune page n'est un remplissage générique.",
  },
  {
    n: "4",
    title: "Relecture et mise en cohérence humaine",
    duration: "Jour 6-8",
    text: "Un humain relit l'intégralité du site : exactitude des informations, ton, absence de répétitions, vérification des liens et du design sur mobile.",
  },
  {
    n: "5",
    title: "Vous validez",
    duration: "Jour 8-9",
    text: "Vous recevez un lien de prévisualisation. Vous demandez les ajustements nécessaires — c'est inclus tant que ça reste dans le cadre du pack initial.",
  },
  {
    n: "6",
    title: "Mise en ligne",
    duration: "Jour 9-10",
    text: "Le site est publié sur votre nom de domaine, indexé auprès de Google, et vous recevez un guide simple pour les modifications de base que vous pourriez vouloir faire seul.",
  },
];
---

<BaseLayout
  title="Comment ça marche — le processus de création Balise étape par étape"
  description="Du premier échange à la mise en ligne : découvrez précisément comment Balise construit votre site vitrine de 20 à 30 pages en une dizaine de jours."
>
  <section class="reveal container-balise pt-16 pb-12">
    <p class="text-sm font-medium uppercase tracking-wide text-signal">Le processus</p>
    <h1 class="mt-3 max-w-2xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">
      Ce qui se passe réellement entre votre message et votre site en ligne
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft">
      Pas de boîte noire. Voici les six étapes, avec un délai indicatif pour chacune. La durée totale habituelle est de 7 à 10 jours ouvrés à partir de la réception de vos informations.
    </p>
  </section>

  <section class="reveal container-balise py-8 pb-20">
    <div class="relative space-y-8 border-l border-line pl-8 sm:pl-10">
      {steps.map((step) => (
        <div class="relative">
          <span class="absolute -left-[3.05rem] flex h-8 w-8 items-center justify-center rounded-full bg-ink font-display text-sm font-semibold text-paper sm:-left-[3.55rem]">
            {step.n}
          </span>
          <div class="rounded-2xl border border-line bg-white p-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="font-display text-lg font-semibold text-ink">{step.title}</h2>
              <span class="rounded-full bg-signal-light px-3 py-1 text-xs font-medium text-signal">{step.duration}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="reveal container-balise pb-24">
    <div class="rounded-3xl border border-line bg-paper-dim p-8 sm:p-10">
      <h2 class="font-display text-2xl font-bold text-ink">Et après la mise en ligne ?</h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
        Le site vous appartient : vous pouvez le faire évoluer seul avec le guide fourni, nous solliciter ponctuellement, ou prendre l'option de suivi mensuel sans engagement présentée sur la page tarifs. Il n'y a aucune obligation de continuer avec nous après la livraison.
      </p>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
