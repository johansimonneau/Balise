---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";

const exemples = [
  {
    secteur: "Artisan du bâtiment",
    pages: "24 pages",
    structure: ["Accueil", "6 pages métiers (rénovation, électricité, plomberie...)", "Zone d'intervention (8 communes)", "Réalisations", "Devis", "Contact"],
  },
  {
    secteur: "Coach indépendante",
    pages: "22 pages",
    structure: ["Accueil", "Méthode", "5 pages par type d'accompagnement", "Témoignages", "Blog (option incluse)", "Réserver un appel"],
  },
  {
    secteur: "Restaurant de quartier",
    pages: "18 pages",
    structure: ["Accueil", "Carte détaillée", "Menu du midi", "Événements privés", "Galerie", "Avis", "Réservation", "Contact & horaires"],
  },
];
---

<BaseLayout
  title="Réalisations — exemples de structures de site Cairn"
  description="Aperçu de la manière dont Cairn structure un site vitrine de 20 à 30 pages selon le secteur d'activité, avant publication des premiers projets clients réels."
>
  <section class="container-cairn pt-16 pb-8">
    <p class="text-sm font-medium uppercase tracking-wide text-moss">Réalisations</p>
    <h1 class="mt-3 max-w-2xl font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      À quoi ressemble un site Cairn, concrètement
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft">
      Cairn est un service jeune : cette page présente pour l'instant des exemples de structure type, secteur par secteur, pour montrer comment un pack de 20 à 30 pages se construit concrètement. Les premiers projets clients réels viendront progressivement remplacer ces exemples.
    </p>
    <p class="mt-4 max-w-2xl rounded-xl border border-line bg-paper-dim px-4 py-3 text-sm text-ink-soft">
      Transparence : les trois cas ci-dessous sont des exemples de structure (maquettes de démonstration), pas des sites de clients existants.
    </p>
  </section>

  <section class="container-cairn py-8 pb-24">
    <div class="grid gap-6 md:grid-cols-3">
      {exemples.map((ex) => (
        <div class="rounded-3xl border border-line bg-white p-6">
          <span class="inline-flex rounded-full bg-moss-light px-3 py-1 text-xs font-medium text-moss">{ex.pages}</span>
          <h2 class="mt-4 font-display text-lg font-semibold text-ink">{ex.secteur}</h2>
          <ul class="mt-4 space-y-2">
            {ex.structure.map((line) => (
              <li class="flex items-start gap-2 text-sm text-ink-soft">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-stone"></span>
                {line}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <CTABanner
    title="Votre secteur n'est pas dans la liste ?"
    description="Le pack s'adapte à votre activité, quelle qu'elle soit. Décrivez-la nous, on vous propose une structure sur mesure."
    cta="Décrire mon activité"
  />
</BaseLayout>
