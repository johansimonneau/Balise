---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";

// À COMPLÉTER : remplacez secteur/description/url pour chaque projet avec les informations réelles.
const projets = [
  {
    nom: "Nidly",
    secteur: "[À COMPLÉTER — secteur d'activité]",
    description: "[À COMPLÉTER — une ou deux phrases sur le projet : objectif, ce qui a été mis en place, résultat obtenu]",
    url: "",
  },
  {
    nom: "johansimonneau.fr",
    secteur: "Site personnel — acquisition digitale (SEO, GEO, Ads)",
    description: "[À COMPLÉTER — une ou deux phrases sur le positionnement du site et ce qu'il présente]",
    url: "https://johansimonneau.fr",
  },
  {
    nom: "Studio Cairn",
    secteur: "[À COMPLÉTER — secteur d'activité]",
    description: "[À COMPLÉTER — une ou deux phrases sur le projet]",
    url: "",
  },
  {
    nom: "Velodom",
    secteur: "[À COMPLÉTER — secteur d'activité]",
    description: "[À COMPLÉTER — une ou deux phrases sur le projet]",
    url: "",
  },
];
---

<BaseLayout
  title="Réalisations — les projets web menés par Johan Simonneau"
  description="Un aperçu des sites conçus par Johan Simonneau (Nidly, Studio Cairn, Velodom...), avant l'arrivée des premiers projets clients Balise."
>
  <section class="reveal container-balise pt-16 pb-8">
    <p class="text-sm font-medium uppercase tracking-wide text-signal">Réalisations</p>
    <h1 class="mt-3 max-w-2xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">
      Des sites déjà conçus, une méthode qui a fait ses preuves
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft">
      Balise est un service jeune, mais pas une première expérience : Johan Simonneau conçoit des sites depuis plusieurs années. Voici quelques projets menés avant Balise, qui donnent une idée du niveau d'exigence appliqué à chaque site — désormais accéléré par l'IA sur la partie rédaction et structure.
    </p>
    <p class="mt-4 max-w-2xl rounded-xl border border-line bg-paper-dim px-4 py-3 text-sm text-ink-soft">
      Transparence : ces projets n'ont pas été réalisés avec le processus IA + relecture humaine décrit sur ce site — ils illustrent l'expérience web de Johan, pas encore un projet client Balise. Les premiers projets Balise viendront enrichir cette page au fil des livraisons.
    </p>
  </section>

  <section class="reveal container-balise py-8 pb-24">
    <div class="grid gap-6 sm:grid-cols-2">
      {projets.map((p) => (
        <div class="rounded-3xl border border-line bg-white p-6">
          <div class="flex items-center justify-between gap-3">
            <h2 class="font-display text-lg font-semibold text-ink">{p.nom}</h2>
            {p.url && (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-xs font-medium text-signal hover:underline">
                Voir le site ↗
              </a>
            )}
          </div>
          <span class="mt-2 inline-flex rounded-full bg-signal-light px-3 py-1 text-xs font-medium text-signal">{p.secteur}</span>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft">{p.description}</p>
        </div>
      ))}
    </div>
  </section>

  <CTABanner
    title="Votre secteur n'est pas dans la liste ?"
    description="Le pack s'adapte à votre activité, quelle qu'elle soit. Décrivez-la nous, on vous propose une structure sur mesure."
    cta="Décrire mon activité"
  />
</BaseLayout>
