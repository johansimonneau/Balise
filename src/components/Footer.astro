---
const columns = [
  {
    title: "Offre",
    links: [
      { href: "/offre", label: "L'offre Balise" },
      { href: "/tarifs", label: "Tarifs" },
      { href: "/comment-ca-marche", label: "Comment ça marche" },
      { href: "/realisations", label: "Réalisations" },
    ],
  },
  {
    title: "Pour qui",
    links: [
      { href: "/sites-internet/artisan", label: "Artisans" },
      { href: "/sites-internet/profession-liberale", label: "Professions libérales" },
      { href: "/sites-internet/restaurant", label: "Restaurants" },
      { href: "/sites-internet/commerce-local", label: "Commerces locaux" },
      { href: "/sites-internet/coach-independant", label: "Coachs & indépendants" },
      { href: "/sites-internet/association", label: "Associations" },
    ],
  },
  {
    title: "Ressources",
    links: [
      { href: "/blog", label: "Blog" },
      { href: "/faq", label: "FAQ" },
      { href: "/a-propos", label: "À propos" },
      { href: "/contact", label: "Contact" },
    ],
  },
  {
    title: "Confiance",
    links: [
      { href: "/securite-donnees", label: "Sécurité & données" },
      { href: "/mentions-legales", label: "Mentions légales" },
      { href: "/cgv", label: "CGV" },
      { href: "/politique-de-confidentialite", label: "Confidentialité" },
      { href: "/cookies", label: "Cookies" },
    ],
  },
];
---

<footer class="border-t border-line bg-paper-dim">
  <div class="container-balise grid gap-10 py-16 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold text-ink">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-paper">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3L20 20H4L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M9 20L12 12L15 20" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
        </span>
        Balise
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-soft">
        Des sites web posés par l'IA, cadrés par des humains. On balise le chemin pour que les petites entreprises aient enfin un site qui travaille pour elles.
      </p>
      <p class="mt-6 text-xs text-stone">© {new Date().getFullYear()} Balise — Johan Simonneau. Fait avec Astro, hébergé sur GitHub Pages.</p>
    </div>

    {columns.map((col) => (
      <div>
        <h3 class="font-display text-sm font-semibold text-ink">{col.title}</h3>
        <ul class="mt-4 space-y-2.5">
          {col.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-soft transition-colors hover:text-moss">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</footer>
