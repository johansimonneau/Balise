---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const columns = [
  {
    title: "Offre",
    links: [
      { href: `${base}/offre`, label: "L'offre Balise" },
      { href: `${base}/tarifs`, label: "Tarifs" },
      { href: `${base}/comment-ca-marche`, label: "Comment ça marche" },
      { href: `${base}/realisations`, label: "Réalisations" },
    ],
  },
  {
    title: "Pour qui",
    links: [
      { href: `${base}/sites-internet/artisan`, label: "Artisans" },
      { href: `${base}/sites-internet/profession-liberale`, label: "Professions libérales" },
      { href: `${base}/sites-internet/restaurant`, label: "Restaurants" },
      { href: `${base}/sites-internet/commerce-local`, label: "Commerces locaux" },
      { href: `${base}/sites-internet/coach-independant`, label: "Coachs & indépendants" },
      { href: `${base}/sites-internet/association`, label: "Associations" },
    ],
  },
  {
    title: "Ressources",
    links: [
      { href: `${base}/blog`, label: "Blog" },
      { href: `${base}/faq`, label: "FAQ" },
      { href: `${base}/a-propos`, label: "À propos" },
      { href: `${base}/contact`, label: "Contact" },
    ],
  },
  {
    title: "Confiance",
    links: [
      { href: `${base}/securite-donnees`, label: "Sécurité & données" },
      { href: `${base}/mentions-legales`, label: "Mentions légales" },
      { href: `${base}/cgv`, label: "CGV" },
      { href: `${base}/politique-de-confidentialite`, label: "Confidentialité" },
      { href: `${base}/cookies`, label: "Cookies" },
    ],
  },
];
---

<footer class="border-t border-line bg-paper-dim">
  <div class="container-balise grid gap-10 py-16 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <a href={`${base}/`} class="flex items-center gap-2 font-display text-lg font-semibold text-ink">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-paper">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3L20 20H4L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M9 20L12 12L15 20" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
        </span>
        Balise
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-soft">
        Des sites web posés par l'IA, cadrés par des humains. On balise le chemin pour que les petites entreprises aient enfin un site qui travaille pour elles.
      </p>
      <p class="mt-6 text-xs text-stone">© {new Date().getFullYear()} Balise — Johan Simonneau. Fait avec Astro, hébergé sur GitHub Pages.</p>
    </div>

    {columns.map((col) => (
      <div>
        <h3 class="font-display text-sm font-semibold text-ink">{col.title}</h3>
        <ul class="mt-4 space-y-2.5">
          {col.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-soft transition-colors hover:text-signal">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</footer>
