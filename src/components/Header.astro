---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  { href: `${base}/offre`, label: "L'offre" },
  { href: `${base}/tarifs`, label: "Tarifs" },
  { href: `${base}/realisations`, label: "Réalisations" },
  { href: `${base}/blog`, label: "Blog" },
  { href: `${base}/faq`, label: "FAQ" },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/90 backdrop-blur">
  <div class="container-balise flex h-16 items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-ink">
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-paper">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3L20 20H4L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M9 20L12 12L15 20" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
      </span>
      Balise
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navigation principale">
      {nav.map((item) => (
        <a
          href={item.href}
          class={`text-sm transition-colors hover:text-moss ${current === item.href ? "font-semibold text-moss" : "text-ink-soft"}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href={`${base}/contact`}
      class="hidden rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-transform hover:-translate-y-0.5 hover:bg-moss md:inline-flex"
    >
      Démarrer mon site
    </a>

    <button
      id="menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line md:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-line bg-paper md:hidden" aria-label="Navigation mobile">
    <div class="container-balise flex flex-col gap-1 py-4">
      {nav.map((item) => (
        <a href={item.href} class="rounded-lg px-3 py-2.5 text-sm text-ink-soft hover:bg-paper-dim">
          {item.label}
        </a>
      ))}
      <a href={`${base}/contact`} class="mt-2 rounded-full bg-ink px-4 py-2.5 text-center text-sm font-medium text-paper">
        Démarrer mon site
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isHidden));
  });
</script>
