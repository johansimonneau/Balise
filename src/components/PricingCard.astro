---
interface Props {
  name: string;
  price: string;
  priceNote?: string;
  description: string;
  features: string[];
  cta?: string;
  href?: string;
  highlight?: boolean;
  badge?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  name,
  price,
  priceNote = "net, paiement unique",
  description,
  features,
  cta = "Démarrer mon projet",
  href = `${base}/contact`,
  highlight = false,
  badge,
} = Astro.props;
---

<div class={`relative flex flex-col rounded-3xl border p-8 ${highlight ? "border-ink bg-ink text-paper shadow-xl shadow-ink/10" : "border-line bg-white"}`}>
  {badge && (
    <span class="absolute -top-3 left-8 rounded-full bg-clay px-3 py-1 text-xs font-semibold text-white">
      {badge}
    </span>
  )}
  <h3 class={`font-display text-xl font-semibold ${highlight ? "text-paper" : "text-ink"}`}>{name}</h3>
  <p class={`mt-2 text-sm ${highlight ? "text-paper/70" : "text-ink-soft"}`}>{description}</p>

  <div class="mt-6 flex items-baseline gap-2">
    <span class="font-display text-4xl font-bold">{price}</span>
    <span class={`text-xs ${highlight ? "text-paper/60" : "text-stone"}`}>{priceNote}</span>
  </div>

  <ul class="mt-8 flex-1 space-y-3">
    {features.map((feature) => (
      <li class="flex items-start gap-2.5 text-sm">
        <svg class={`mt-0.5 h-4 w-4 shrink-0 ${highlight ? "text-clay-light" : "text-signal"}`} viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12.5L9.5 17L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class={highlight ? "text-paper/90" : "text-ink-soft"}>{feature}</span>
      </li>
    ))}
  </ul>

  <a
    href={href}
    class={`mt-8 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-medium transition-transform hover:-translate-y-0.5 ${highlight ? "bg-clay text-white hover:bg-clay/90" : "bg-ink text-paper hover:bg-signal"}`}
  >
    {cta}
  </a>
</div>
