---
interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const {
  title,
  description,
  path = Astro.url.pathname,
  image = `${base}/og-balise.svg`,
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://johansimonneau.github.io";
const canonical = `${site}${path}`;
const fullTitle = title.includes("Balise") ? title : `${title} · Balise`;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={`${site}${image}`} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content="Balise" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${site}${image}`} />

{jsonLdList.map((entry) => (
  <script type="application/ld+json" set:html={JSON.stringify(entry).replace(/</g, "\\u003c")} />
))}
